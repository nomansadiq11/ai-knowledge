# Environment Configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
# If running the web UI in Docker, this points to the host's Ollama.
# On macOS/Windows, host.docker.internal resolves to the host.
# If running outside Docker, use: OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama2

# ChromaDB Configuration (if using external ChromaDB)
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# Application Settings
# Upload directory (relative to app.py)
# UPLOAD_DIR=uploads

# Vector database directory (relative to app.py)
# CHROMA_DB_DIR=chroma_db

# Streamlit Configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Text Splitting Configuration
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# Retrieval Configuration
# RETRIEVAL_K=3  # Number of documents to retrieve

# Embedding Model
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
